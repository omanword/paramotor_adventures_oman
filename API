<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paragliding Ticket Booking</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="container">
    <!-- Paragliding Photo -->
    <div class="paragliding-photo">
      <img src="paragliding.jpg" alt="Paragliding Adventure">
    </div>

    <h1>Book Your Paragliding Adventure</h1>
    <form id="bookingForm">
      <div class="form-group">
        <label for="fullName">Full Name:</label>
        <input type="text" id="fullName" placeholder="Enter your full name" required>
      </div>
      <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" id="email" placeholder="Enter your email" required>
      </div>
      <div class="form-group">
        <label for="phone">Phone Number:</label>
        <input type="tel" id="phone" placeholder="Enter your phone number" required>
      </div>
      <div class="form-group">
        <label for="date">Date:</label>
        <input type="date" id="date" required>
      </div>
      <div class="form-group">
        <label for="location">Location:</label>
        <select id="location" required>
          <option value="">Select a location</option>
          <option value="Mountainside">Mountainside</option>
          <option value="Beachside">Beachside</option>
          <option value="Cliffside">Cliffside</option>
        </select>
      </div>

      <!-- Captain Selection -->
      <div class="form-group">
        <label for="captain">Select Captain:</label>
        <select id="captain" required>
          <option value="">Select a captain</option>
          <option value="Captain Ahmed, Muscat team">Captain Ahmed, Muscat team</option>
          <option value="Captain Adallah, Muscat team">Captain Adallah, Muscat team</option>
          <option value="Captain Khaled, Al Dhahirah team">Captain Khaled, Al Dhahirah team</option>
        </select>
      </div>

      <!-- Payment Section -->
      <div class="payment-section">
        <h3>Payment Details</h3>
        <p>Airfare: <strong>27 Omani Riyals</strong></p>
        <p>Please transfer the amount to the following account number:</p>
        <p><strong>Account Number: 5558889992200</strong></p>
        <div class="form-group">
          <label for="paymentConfirmation">Payment Confirmation:</label>
          <input type="text" id="paymentConfirmation" placeholder="Enter transaction ID" required>
        </div>
      </div>

      <button type="submit">Book Now</button>
    </form>
    <div id="confirmationMessage" class="hidden">
      <h2>Booking Confirmed!</h2>
      <p id="confirmationDetails"></p>
    </div>
  </div>
  <script src="script.js"></script>
</body>
</html>